NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://rivet:rivet@localhost:5432/rivet
REDIS_URL=redis://localhost:6379
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# For Groq, set AI_PROVIDER=groq and provide both values:
# GROQ_API_KEY=
# GROQ_MODEL=
# For Gemini, set AI_PROVIDER=gemini and provide both values:
# GEMINI_API_KEY=
# GEMINI_MODEL=
# For OpenRouter, set AI_PROVIDER=openrouter and select openrouter/free or a :free model:
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
