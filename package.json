{
  "name": "rivet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.21.0"
  },
  "scripts": {
    "lint": "pnpm exec oxlint",
    "lint:fix": "pnpm exec oxlint --fix",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "prepare": "husky",
    "build": "pnpm --recursive --sort --if-present build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.19.2",
    "husky": "^9.1.7",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.21.0"
}
