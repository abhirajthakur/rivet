{
  "name": "rivet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.34.9"
  },
  "scripts": {
    "lint": "corepack pnpm exec eslint .",
    "lint:fix": "corepack pnpm exec eslint . --fix",
    "format": "corepack pnpm exec prettier --write .",
    "format:check": "corepack pnpm exec prettier --check .",
    "typecheck": "corepack pnpm --recursive --if-present typecheck",
    "check": "corepack pnpm lint && corepack pnpm format:check && corepack pnpm typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.2"
  },
  "packageManager": "pnpm@10.34.9"
}
